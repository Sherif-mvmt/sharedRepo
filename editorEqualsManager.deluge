//CONFIG START
userLookupKey = "udf_ref4";
// User lookup additional field key whose value should be copied to editor
//CONFIG END
apiPrefix = "/app/" + context.get("instance") + "/api/v3/";
requestId = requestObj.get("id");
// ── 1. Read the user lookup UDF ──────────────────────────────────────────
udfFields = requestObj.get("udf_fields");
selectedUser = udfFields.get(userLookupKey);
selectedUserId = selectedUser.get("id");
// ── 2. Set editor to the selected user via PUT ────────────────────────────
updateResp = zoho.sdp.invokeurl
[
    url :apiPrefix + "requests/" + requestId
    type :PUT
    parameters:{"input_data":{"request":{"editor":{"id":selectedUserId}}}}
];
info "Copy UDF to Editor — Response: " + updateResp.get("response_status");